# Production environment template.
# Copy to the production host (or CI secrets) as `.env` on the deploy that runs
# the `main` branch. NEVER commit real secrets. Use `openssl rand -hex 32` for
# the key/token placeholders below.

# Runtime (set NODE_ENV=production for real hosts; simulators are rejected)
NODE_ENV=production
PORT=4000
API_PUBLIC_URL=https://api.yourdomain.com
CUSTOMER_WEB_URL=https://customer.yourdomain.com
OPS_WEB_URL=https://ops.yourdomain.com

# Sensitive-data protection (MANDATORY in production)
APP_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
PII_HASH_KEY=replace-with-a-long-random-key

# CockroachDB / Prisma
DATABASE_URL=postgresql://user:password@host:26257/visa_compass?sslmode=require
PERSISTENCE_MODE=prisma

# Clerk (production instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
# MANDATORY in production: bootstrap fails closed without this token.
# Generate with: openssl rand -hex 32
BOOTSTRAP_SUPER_ADMIN_TOKEN=
ENFORCE_SUPER_ADMIN_MFA=true
STAFF_EMAIL_DOMAIN=visacompassnepal.com

# BullMQ Redis (MANDATORY for real background jobs in production)
REDIS_URL=
QUEUE_CONCURRENCY=3
RECONCILIATION_INTERVAL_MINUTES=15

# Observability
LOG_FORMAT=json
OPS_ALERT_EMAIL=

# Guest checkout
GUEST_ORDER_SECRET=replace-with-a-long-random-guest-token-secret

# API hardening
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=60
BODY_LIMIT=5mb
# Set to the number of trusted proxy hops (e.g. 1) behind a load balancer.
TRUST_PROXY=
SWAGGER_ENABLED=false

# Payments (Khalti is the sole payment gateway)
PAYMENT_MODE=production
PAYMENT_SIMULATOR_SECRET=local-development-only-change-me
KHALTI_BASE_URL=https://khalti.com/api/v2
KHALTI_SECRET_KEY=
KHALTI_REQUEST_TIMEOUT_MS=15000

# Connectivity (Transatel production)
TRANSATEL_BASE_URL=https://api.transatel.com
TRANSATEL_CLIENT_ID=
TRANSATEL_CLIENT_SECRET=
TRANSATEL_MVNO_REF=
TRANSATEL_COS=
TRANSATEL_PAYMENT_PROVIDER=
TRANSATEL_SUBSCRIBER_IDENTIFIER=iccid
TRANSATEL_FX_TO_NPR=170
TRANSATEL_CATALOG_SYNC_ON_STARTUP=false
TRANSATEL_WEBHOOK_TARGET_URL=
TRANSATEL_WEBHOOK_CONTACT_EMAIL=
TRANSATEL_WEBHOOK_SECRET=
TRANSATEL_WEBHOOK_EVENTS=OCS/PRODUCT/PRELOADED,OCS/PRODUCT/ACTIVATED,OCS/PRODUCT/EXPIRED,OCS/PRODUCT/TERMINATED
TRANSATEL_REQUEST_TIMEOUT_MS=15000

# Private document storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notifications (set NOTIFICATION_MODE=live for real delivery)
NOTIFICATION_MODE=simulator
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_ADDRESS=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Both Next.js portals use this public API base URL
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# JSON array of partner id + SHA-256 API-key hash; never store plaintext keys
PARTNER_API_KEYS_JSON=[]
