# Production environment template.
# Copy to the production host (or CI secrets) as `.env` on the deploy that runs
# the `main` branch. NEVER commit real secrets. Use `openssl rand -hex 32` for
# the key/token placeholders below.

# Runtime (set NODE_ENV=production for real hosts; simulators are rejected)
NODE_ENV=production
PORT=4000
API_PUBLIC_URL=https://api.yourdomain.com
CUSTOMER_WEB_URL=https://customer.yourdomain.com
OPS_WEB_URL=https://ops.yourdomain.com

# Sensitive-data protection (MANDATORY in production)
APP_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
PII_HASH_KEY=replace-with-a-long-random-key

# CockroachDB / Prisma
DATABASE_URL=postgresql://user:password@host:26257/visa_compass?sslmode=require
PERSISTENCE_MODE=prisma
# Required until the order workflow is redesigned around database-backed state
# and distributed locks. Do not deploy more than one API replica in this mode.
ORDER_WORKFLOW_MODE=database-first
PROCESS_ROLE=api
QUEUE_ENQUEUE_TIMEOUT_MS=2000
INVENTORY_PROVIDER_FRESHNESS_HOURS=24
INVENTORY_RESERVATION_STALE_HOURS=2
REFUND_ATTENTION_HOURS=24

# Clerk (production instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
# MANDATORY in production: bootstrap fails closed without this token.
# Generate with: openssl rand -hex 32
BOOTSTRAP_SUPER_ADMIN_TOKEN=
ENFORCE_SUPER_ADMIN_MFA=true
STAFF_EMAIL_DOMAIN=visacompassnepal.com

# BullMQ Redis (MANDATORY for real background jobs in production)
REDIS_URL=
QUEUE_CONCURRENCY=3
RECONCILIATION_INTERVAL_MINUTES=15
# Fast re-check of pending payments within their window (seconds). Backstop for
# browser verification; only fires while the instance is awake (browser return
# + external health cron keep Render awake).
PAYMENT_RECONCILE_INTERVAL_SECONDS=45
PAYMENT_VERIFY_ATTEMPTS=3

# Observability
LOG_FORMAT=json
OPS_ALERT_EMAIL=

# Guest checkout
GUEST_ORDER_SECRET=replace-with-a-long-random-guest-token-secret

# API hardening
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=60
BODY_LIMIT=5mb
# Set to the number of trusted proxy hops (e.g. 1) behind a load balancer.
TRUST_PROXY=1
SWAGGER_ENABLED=false

# Payments (Khalti is the sole payment gateway)
PAYMENT_MODE=khalti
PAYMENT_SIMULATOR_SECRET=local-development-only-change-me
# MANDATORY in production: HMAC secret used to verify payment webhook callbacks
# (X-Visa-Signature). Generate with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=
KHALTI_BASE_URL=https://khalti.com/api/v2
KHALTI_SECRET_KEY=
KHALTI_REQUEST_TIMEOUT_MS=15000

# Connectivity (Transatel production)
CONNECTIVITY_PROVIDER=transatel
TRANSATEL_BASE_URL=https://api.transatel.com
TRANSATEL_CLIENT_ID=
TRANSATEL_CLIENT_SECRET=
TRANSATEL_MVNO_REF=
TRANSATEL_COS=
TRANSATEL_PAYMENT_PROVIDER=
TRANSATEL_SUBSCRIBER_IDENTIFIER=iccid
TRANSATEL_FX_TO_NPR=170
TRANSATEL_CATALOG_SYNC_ON_STARTUP=false
TRANSATEL_WEBHOOK_TARGET_URL=
TRANSATEL_WEBHOOK_CONTACT_EMAIL=
TRANSATEL_WEBHOOK_SECRET=
TRANSATEL_WEBHOOK_EVENTS=OCS/PRODUCT/PRELOADED,OCS/PRODUCT/ACTIVATED,OCS/PRODUCT/EXPIRED,OCS/PRODUCT/TERMINATED,CONNECTIVITY-MANAGEMENT/SUBSCRIBER/SUSPENDED,CONNECTIVITY-MANAGEMENT/SUBSCRIBER/TERMINATED
TRANSATEL_REQUEST_TIMEOUT_MS=15000
TRANSATEL_CIRCUIT_FAILURE_THRESHOLD=5
TRANSATEL_CIRCUIT_RESET_MS=30000
TRANSATEL_INVENTORY_RECONCILE_HOURS=24
TRANSATEL_INVENTORY_RECONCILE_BATCH_SIZE=25

# Private document storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notifications (QR delivery is a production requirement)
NOTIFICATION_MODE=live
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Visa Compass
EMAIL_REPLY_TO=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Both Next.js portals use this public API base URL
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_CUSTOMER_WEB_URL=https://customer.yourdomain.com

# JSON array of partner id + SHA-256 API-key hash; never store plaintext keys
PARTNER_API_KEYS_JSON=[]
