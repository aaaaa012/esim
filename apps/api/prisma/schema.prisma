generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum UserRoleName {
  CUSTOMER
  OPERATIONS
  SUPER_ADMIN
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum CustomerSource {
  WEBSITE
  PARTNER
  KHALTI
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum PlanStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum CatalogImportStatus {
  APPLIED
  FAILED
}

enum CatalogImportRowChange {
  NEW
  UPDATED
  UNCHANGED
  MISSING
  RETURNED
  INVALID
}

enum OrderType {
  INITIAL_PURCHASE
  TOPUP
}

enum OrderChannel {
  CUSTOMER_WEB
  PARTNER_API
  PARTNER_HOSTED
}

enum OrderStatus {
  DRAFT
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  REVIEW_PENDING
  AWAITING_CUSTOMER
  APPROVED
  PROVISIONING
  QR_READY
  COMPLETED
  PAYMENT_FAILED
  PAYMENT_REVIEW_REQUIRED
  CANCELLED
  PROVISIONING_FAILED
  ACTIVATION_ATTENTION
  REFUND_PENDING
  REFUNDED
}

enum PaymentProvider {
  KHALTI
  FONEPAY
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REVIEW_REQUIRED
  REFUNDED
  DISPUTED
  CHARGED_BACK
}

enum PaymentInitiationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentDisputeType {
  CHARGEBACK
  DISPUTE
}

enum PaymentDisputeStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
  RESOLVED
}

enum DocumentType {
  PASSPORT
  TICKET
  VISA
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  REUPLOAD_REQUIRED
}

enum InventoryStatus {
  IMPORTED
  PENDING_PROVIDER_CHECK
  AVAILABLE
  RESERVED
  ASSIGNED
  ACTIVATED
  EXPIRED
  TERMINATED
  QUARANTINED
}

enum BatchStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  REJECTED
  REUPLOAD_REQUIRED
}

enum DocumentReviewPolicy {
  AUTO_OCR
  MANUAL_REVIEW
  NO_REVIEW
}

enum OperationalDisposition {
  RETRY_AUTOMATIC
  RECONCILE_PROVIDER
  MANUAL_ACTION
  REFUND_ELIGIBLE
  TERMINAL_REJECTION
}

enum AttentionCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  ENQUEUED
  PROCESSED
  FAILED
}

enum DocumentReviewStatus {
  NOT_STARTED
  OCR_PENDING
  OCR_BACKGROUND
  VERIFIED
  CORRECTION_REQUIRED
  MANUAL_REVIEW
  REUPLOAD_REQUIRED
  MANUALLY_APPROVED
  SKIPPED
}

enum ProvisioningStatus {
  QUEUED
  RUNNING
  DELAYED
  SUCCEEDED
  RETRYING
  FAILED
}

enum ProvisioningOperationState {
  CREATED
  SUBMITTING
  ACCEPTED
  WAITING_FOR_QR
  QR_READY
  ACTIVATED
  RECONCILE_REQUIRED
  REJECTED
  MANUAL_REVIEW
  CANCELLED
}

enum TransatelLifecycleAction {
  SUSPEND
  REACTIVATE
  TERMINATE
}

enum TransatelLifecycleState {
  APPROVAL_REQUIRED
  CREATED
  SUBMITTING
  ACCEPTED
  CONFIRMED
  RECONCILE_REQUIRED
  FAILED
  REJECTED
  EXPIRED
}

enum ManualRefundStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
}

enum ManualRefundReason {
  PROVISIONING_FAILURE
  INCORRECT_FULFILLMENT
  DUPLICATE_CHARGE
  PROVIDER_SERVICE_FAILURE
  INTERNAL_OPERATIONAL_ERROR
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED
  FAILED
}

enum AssignmentVerificationStatus {
  PENDING
  VERIFIED
  MISMATCH
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PartnerCredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PartnerPriceListStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PartnerSettlementMethod {
  PARTNER_ACCOUNT
  HOSTED_PAYMENT
}

enum PartnerIntegrationType {
  API
  CHECKOUT_LINK
}

enum PartnerQuoteStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  CANCELLED
}

enum PartnerLedgerEntryType {
  CREDIT
  DEBIT
  RESERVATION
  CAPTURE
  RELEASE
  REFUND
  ADJUSTMENT
}

enum PartnerRefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum PartnerWebhookDeliveryStatus {
  PENDING
  DELIVERED
  RETRYING
  FAILED
}

enum PartnerIdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ApiIdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                                    String                        @id @default(uuid()) @db.Uuid
  clerkId                               String                        @unique
  email                                 String                        @unique
  status                                UserStatus                    @default(ACTIVE)
  accountType                           UserRoleName                  @default(CUSTOMER)
  mustChangePassword                    Boolean                       @default(false)
  roles                                 UserRole[]
  rechargePurchases                     Order[]                       @relation("RechargePurchaser")
  customer                              Customer?
  reviews                               OrderReview[]
  auditLogs                             AuditLog[]
  transatelLifecycleOperationsRequested TransatelLifecycleOperation[] @relation("TransatelLifecycleRequester")
  transatelLifecycleOperationsApproved  TransatelLifecycleOperation[] @relation("TransatelLifecycleApprover")
  manualRefundsRequested                ManualRefund[]                @relation("ManualRefundRequester")
  manualRefundsReviewed                 ManualRefund[]                @relation("ManualRefundReviewer")
  staffInvitationsSent                  StaffInvitation[]             @relation("StaffInvitationInviter")
  createdAt                             DateTime                      @default(now())
  updatedAt                             DateTime                      @updatedAt
}

model StaffInvitation {
  id                  String                @id @default(uuid()) @db.Uuid
  email               String
  accountType         UserRoleName
  status              StaffInvitationStatus @default(PENDING)
  clerkInvitationId   String?               @unique
  activationTokenHash String?               @unique
  invitedById         String                @db.Uuid
  invitedBy           User                  @relation("StaffInvitationInviter", fields: [invitedById], references: [id])
  acceptedById        String?               @db.Uuid
  expiresAt           DateTime
  acceptedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([email, status])
}

model Role {
  id    String       @id @default(uuid()) @db.Uuid
  name  UserRoleName @unique
  users UserRole[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Customer {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String?           @unique @db.Uuid
  user              User?             @relation(fields: [userId], references: [id])
  customerCode      String            @unique
  source            CustomerSource    @default(WEBSITE)
  email             String            @unique
  phone             String?
  preferredLanguage String            @default("en")
  status            CustomerStatus    @default(ACTIVE)
  orders            Order[]
  esims             CustomerEsim[]
  consents          CustomerConsent[]
  partnerIdentity   PartnerCustomer?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
}

model Country {
  id      String  @id @default(uuid()) @db.Uuid
  isoCode String  @unique
  name    String
  active  Boolean @default(true)
  plans   Plan[]
}

model Plan {
  id                   String                 @id @default(uuid()) @db.Uuid
  countryId            String                 @db.Uuid
  country              Country                @relation(fields: [countryId], references: [id])
  providerPlanId       String
  name                 String
  dataAllowance        String
  validityDays         Int
  costPrice            Decimal                @db.Decimal(12, 2)
  sellingPrice         Decimal                @db.Decimal(12, 2)
  currency             String                 @default("NPR")
  coverage             Json
  popular              Boolean                @default(false)
  status               PlanStatus             @default(DRAFT)
  lastCatalogSeenAt    DateTime?
  providerMissingSince DateTime?
  orders               Order[]
  partnerPrices        PartnerPriceListItem[]
  partnerQuotes        PartnerQuote[]
  homepageFeatures     HomepageFeaturedPlan[]
  updatedAt            DateTime               @updatedAt

  @@unique([countryId, providerPlanId])
}

model CatalogImportBatch {
  id             String              @id @default(uuid()) @db.Uuid
  batchReference String              @unique
  fileName       String?
  contentHash    String
  mode           String
  status         CatalogImportStatus @default(APPLIED)
  uploadedById   String?             @db.Uuid
  totalRows      Int
  newCount       Int                 @default(0)
  updatedCount   Int                 @default(0)
  unchangedCount Int                 @default(0)
  missingCount   Int                 @default(0)
  returnedCount  Int                 @default(0)
  invalidCount   Int                 @default(0)
  rows           CatalogImportRow[]
  createdAt      DateTime            @default(now())

  @@index([createdAt])
}

model CatalogImportRow {
  id             String                 @id @default(uuid()) @db.Uuid
  batchId        String                 @db.Uuid
  batch          CatalogImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  planId         String?                @db.Uuid
  countryIso2    String
  providerPlanId String
  change         CatalogImportRowChange
  previousValue  Json?
  proposedValue  Json?
  error          String?
  createdAt      DateTime               @default(now())

  @@index([batchId, change])
  @@index([countryIso2, providerPlanId])
}

model Order {
  id                           String                         @id @default(uuid()) @db.Uuid
  orderNumber                  String                         @unique
  purchasedByUserId            String?                        @db.Uuid
  purchasedBy                  User?                          @relation("RechargePurchaser", fields: [purchasedByUserId], references: [id], onDelete: SetNull)
  targetInventoryId            String?                        @db.Uuid
  targetInventory              EsimInventory?                 @relation("RechargeTarget", fields: [targetInventoryId], references: [id], onDelete: Restrict)
  checkoutAttemptKey           String?                        @unique
  checkoutRequestHash          String?
  customerId                   String                         @db.Uuid
  customer                     Customer                       @relation(fields: [customerId], references: [id])
  partnerId                    String?                        @db.Uuid
  partner                      Partner?                       @relation(fields: [partnerId], references: [id])
  partnerCustomerId            String?                        @db.Uuid
  partnerCustomer              PartnerCustomer?               @relation(fields: [partnerCustomerId], references: [id])
  externalOrderId              String?
  partnerQuoteId               String?                        @unique @db.Uuid
  partnerQuote                 PartnerQuote?                  @relation(fields: [partnerQuoteId], references: [id])
  partnerSettlementMethod      PartnerSettlementMethod?
  partnerPaymentProvider       PaymentProvider?
  partnerMetadata              Json?
  planId                       String                         @db.Uuid
  plan                         Plan                           @relation(fields: [planId], references: [id])
  orderType                    OrderType                      @default(INITIAL_PURCHASE)
  channel                      OrderChannel                   @default(CUSTOMER_WEB)
  status                       OrderStatus                    @default(DRAFT)
  currency                     String                         @default("NPR")
  subtotal                     Decimal                        @db.Decimal(12, 2)
  discount                     Decimal                        @default(0) @db.Decimal(12, 2)
  tax                          Decimal                        @default(0) @db.Decimal(12, 2)
  totalAmount                  Decimal                        @db.Decimal(12, 2)
  pricingSnapshot              Json
  compatibilityAcceptedAt      DateTime
  providerSubscriptionId       String?
  providerStatus               String?
  qrDeliveredAt                DateTime?
  activatedAt                  DateTime?
  documentReviewPolicy         DocumentReviewPolicy           @default(AUTO_OCR)
  documentReviewStatus         DocumentReviewStatus           @default(NOT_STARTED)
  documentReviewStartedAt      DateTime?
  documentCheckoutReleaseAt    DateTime?
  activationRefetchAttempts    Int                            @default(0)
  lastProvisioningRecoveryAt   DateTime?
  operationalDisposition       OperationalDisposition?
  traveler                     Traveler?
  passportExtraction           PassportExtraction?
  documents                    TravelerDocument[]
  payments                     Payment[]
  paymentEvents                PaymentEvent[]
  paymentInitiation            PaymentInitiation?
  inventory                    EsimInventory?
  customerEsim                 CustomerEsim?
  reviews                      OrderReview[]
  events                       OrderEvent[]
  provisioningAttempts         ProvisioningAttempt[]
  provisioningOperation        ProvisioningOperation?
  transatelLifecycleOperations TransatelLifecycleOperation[]
  manualRefunds                ManualRefund[]
  paymentDisputes              PaymentDispute[]
  notifications                Notification[]
  guestAccessTokens            GuestOrderAccessToken[]
  partnerLedgerEntries         PartnerLedgerEntry[]
  partnerHostedSessions        PartnerHostedCheckoutSession[]
  partnerRefundRequests        PartnerRefundRequest[]
  partnerEvents                PartnerEvent[]
  attentionCases               AttentionCase[]
  outboxMessages               OutboxMessage[]
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  version                      Int                            @default(0)

  @@unique([partnerId, externalOrderId])
  @@index([purchasedByUserId, createdAt])
  @@index([targetInventoryId])
  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([partnerId])
}

model GuestOrderAccessToken {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String    @db.Uuid
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  purpose       String
  recipientHash String?
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([orderId, purpose, revokedAt, expiresAt])
}

model PlatformConfiguration {
  id                   String               @id @default("platform")
  documentReviewPolicy DocumentReviewPolicy @default(AUTO_OCR)
  ocrCheckoutWaitMs    Int                  @default(8000)
  updatedById          String?              @db.Uuid
  updatedAt            DateTime             @updatedAt
}

model Traveler {
  id                      String  @id @default(uuid()) @db.Uuid
  orderId                 String  @unique @db.Uuid
  order                   Order   @relation(fields: [orderId], references: [id])
  title                   String
  firstName               String
  middleName              String?
  surname                 String
  dateOfBirthEncrypted    String
  nationality             String
  city                    String
  countryOfResidence      String
  employerOrBusinessName  String?
  email                   String
  mobile                  String
  passportNumberEncrypted String
  passportNumberHash      String
  passportExpiryEncrypted String
  pointOfSaleCode         String?
  countryOfPurchase       String  @default("NP")
  subscriberLanguage      String  @default("en")

  @@index([passportNumberHash])
}

model TravelerDocument {
  id                         String         @id @default(uuid()) @db.Uuid
  orderId                    String         @db.Uuid
  order                      Order          @relation(fields: [orderId], references: [id])
  type                       DocumentType
  fileName                   String
  privateAssetId             String
  status                     DocumentStatus @default(PENDING)
  uploadVerified             Boolean        @default(false)
  reviewedById               String?        @db.Uuid
  reviewedAt                 DateTime?
  passportVerificationStatus String?
  passportVerificationMethod String?
  passportMatchedFields      Json?
  passportConfidence         Float?
  passportVerifiedAt         DateTime?
  createdAt                  DateTime       @default(now())

  @@unique([orderId, type])
  @@index([status])
}

model PassportExtraction {
  id                    String                       @id @default(uuid()) @db.Uuid
  orderId               String?                      @unique @db.Uuid
  order                 Order?                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerVerificationId String?                      @unique @db.Uuid
  partnerVerification   PartnerDocumentVerification? @relation(fields: [partnerVerificationId], references: [id], onDelete: Cascade)
  passportAssetId       String
  status                String
  payloadEncrypted      String?
  fieldsRequiringInput  Json?
  confidence            Float?
  method                String?
  failureCode           String?
  confirmedAt           DateTime?
  correctionAttempts    Int                          @default(0)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@index([status, updatedAt])
}

model Payment {
  id                    String           @id @default(uuid()) @db.Uuid
  orderId               String           @db.Uuid
  order                 Order            @relation(fields: [orderId], references: [id])
  manualRefunds         ManualRefund[]
  disputes              PaymentDispute[]
  events                PaymentEvent[]
  provider              PaymentProvider
  providerTransactionId String?
  providerCorrelationId String?
  paymentReference      String           @unique
  amount                Decimal          @db.Decimal(12, 2)
  currency              String           @default("NPR")
  status                PaymentStatus    @default(INITIATED)
  paidAt                DateTime?
  expiresAt             DateTime?
  returnUrl             String?
  redirectUrl           String?
  verificationAttempts  Int              @default(0)
  lastVerifiedAt        DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([provider, providerTransactionId])
  @@index([orderId])
}

model PaymentEvent {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @db.Uuid
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId             String?         @db.Uuid
  payment               Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider              PaymentProvider
  eventType             String
  source                String
  paymentReference      String?
  fromStatus            PaymentStatus?
  toStatus              PaymentStatus?
  amount                Decimal?        @db.Decimal(12, 2)
  currency              String          @default("NPR")
  providerTransactionId String?
  providerMessage       String?
  evidence              Json?
  dedupeKey             String?         @unique
  createdAt             DateTime        @default(now())

  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@index([provider, eventType, createdAt])
}

model PaymentInitiation {
  id             String                  @id @default(uuid()) @db.Uuid
  orderId        String                  @unique @db.Uuid
  order          Order                   @relation(fields: [orderId], references: [id])
  provider       PaymentProvider
  amountNpr      Int
  status         PaymentInitiationStatus @default(PROCESSING)
  claimToken     String                  @db.Uuid
  leaseExpiresAt DateTime
  result         Json?
  errorCode      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, leaseExpiresAt])
}

model FonepayBankDirectoryEntry {
  bankCode     String   @id
  bankName     String
  bankIcon     String?
  packageName  String?
  intentScheme String
  active       Boolean  @default(true)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, bankName])
}

model FonepayBankDirectorySync {
  id               String    @id @default(uuid()) @db.Uuid
  status           String
  requestedById    String?   @db.Uuid
  totalCount       Int       @default(0)
  addedCount       Int       @default(0)
  updatedCount     Int       @default(0)
  deactivatedCount Int       @default(0)
  errorMessage     String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([startedAt])
}

model InventoryBatch {
  id                 String                       @id @default(uuid()) @db.Uuid
  batchReference     String                       @unique
  totalProfiles      Int
  importedCount      Int                          @default(0)
  failedCount        Int                          @default(0)
  status             BatchStatus                  @default(PENDING)
  submittedById      String?                      @db.Uuid
  approvedById       String?                      @db.Uuid
  rejectedById       String?                      @db.Uuid
  approvedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  inventory          EsimInventory[]
  reconciliationRuns InventoryReconciliationRun[]
  createdAt          DateTime                     @default(now())
}

model EsimInventory {
  id                           String                        @id @default(uuid()) @db.Uuid
  batchId                      String                        @db.Uuid
  batch                        InventoryBatch                @relation(fields: [batchId], references: [id])
  iccid                        String                        @unique
  eid                          String                        @unique
  msisdn                       String                        @unique
  status                       InventoryStatus               @default(IMPORTED)
  assignedOrderId              String?                       @unique @db.Uuid
  assignedOrder                Order?                        @relation(fields: [assignedOrderId], references: [id])
  activationCodeEncrypted      String?
  smDpAddress                  String?
  providerSubscriptionId       String?
  providerStatus               String?
  lastProviderCheckedAt        DateTime?
  providerCheckError           String?
  quarantineReason             String?
  activatedAt                  DateTime?
  expiresAt                    DateTime?
  rechargeOrders               Order[]                       @relation("RechargeTarget")
  customerEsims                CustomerEsim[]
  transatelLifecycleOperations TransatelLifecycleOperation[]
  reconciliationItems          InventoryReconciliationItem[]
  version                      Int                           @default(0)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  @@index([status])
}

model InventoryReconciliationRun {
  id            String                        @id @default(uuid()) @db.Uuid
  trigger       String
  status        String                        @default("QUEUED")
  selection     String
  batchId       String?                       @db.Uuid
  batch         InventoryBatch?               @relation(fields: [batchId], references: [id])
  requestedById String?                       @db.Uuid
  total         Int
  items         InventoryReconciliationItem[]
  createdAt     DateTime                      @default(now())
  completedAt   DateTime?

  @@index([status, createdAt])
  @@index([batchId])
}

model InventoryReconciliationItem {
  id          String                     @id @default(uuid()) @db.Uuid
  runId       String                     @db.Uuid
  run         InventoryReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  inventoryId String                     @db.Uuid
  inventory   EsimInventory              @relation(fields: [inventoryId], references: [id])
  status      String                     @default("QUEUED")
  error       String?
  checkedAt   DateTime?

  @@unique([runId, inventoryId])
  @@index([runId, status])
  @@index([inventoryId])
}

model CustomerEsim {
  id                 String         @id @default(uuid()) @db.Uuid
  customerId         String         @db.Uuid
  customer           Customer       @relation(fields: [customerId], references: [id])
  inventoryId        String         @db.Uuid
  inventory          EsimInventory  @relation(fields: [inventoryId], references: [id])
  orderId            String         @unique @db.Uuid
  order              Order          @relation(fields: [orderId], references: [id])
  qrPayloadEncrypted String
  assignedAt         DateTime       @default(now())
  subscriptions      Subscription[]
}

model Subscription {
  id                           String                       @id @default(uuid()) @db.Uuid
  customerEsimId               String                       @db.Uuid
  customerEsim                 CustomerEsim                 @relation(fields: [customerEsimId], references: [id])
  provider                     String
  providerSubscriptionId       String                       @unique
  status                       SubscriptionStatus           @default(PENDING)
  activatedAt                  DateTime?
  expiresAt                    DateTime?
  usedMb                       Int                          @default(0)
  totalMb                      Int                          @default(0)
  usageLastCheckedAt           DateTime?
  assignmentVerificationStatus AssignmentVerificationStatus @default(PENDING)
  assignmentVerifiedAt         DateTime?
  providerLastSeenAt           DateTime?
}

model Partner {
  id                       String                         @id @default(uuid()) @db.Uuid
  code                     String                         @unique
  name                     String
  slug                     String?                        @unique
  brand                    Json?
  status                   PartnerStatus                  @default(PENDING)
  integrationType          PartnerIntegrationType         @default(API)
  allowedSettlementMethods Json
  rateLimitPerMinute       Int                            @default(120)
  redirectAllowlist        Json
  credentials              PartnerCredential[]
  customers                PartnerCustomer[]
  priceLists               PartnerPriceList[]
  quotes                   PartnerQuote[]
  orders                   Order[]
  account                  PartnerAccount?
  ledgerEntries            PartnerLedgerEntry[]
  webhooks                 PartnerWebhookEndpoint[]
  events                   PartnerEvent[]
  idempotencyRecords       PartnerIdempotencyRecord[]
  refundRequests           PartnerRefundRequest[]
  hostedSessions           PartnerHostedCheckoutSession[]
  rateBuckets              PartnerRateBucket[]
  documentUploadIntents    PartnerDocumentUploadIntent[]
  documentVerifications    PartnerDocumentVerification[]
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
}

model PartnerDocumentUploadIntent {
  id                 String                       @id @default(uuid()) @db.Uuid
  partnerId          String                       @db.Uuid
  partner            Partner                      @relation(fields: [partnerId], references: [id])
  verificationId     String?                      @db.Uuid
  verification       PartnerDocumentVerification? @relation(fields: [verificationId], references: [id])
