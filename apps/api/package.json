{
  "name": "@visa-compass/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "node scripts/dev-with-ocr.mjs",
    "start": "node dist/src/main.js",
    "start:with-migrations": "pnpm prisma:deploy && node dist/src/main.js",
    "start:ocr-worker": "node dist/src/ocr-worker.js",
    "start:workflow-worker": "node dist/src/workflow-worker.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js generate",
    "prisma:generate:source": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js generate --schema prisma/source-cockroach.prisma",
    "prisma:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "prisma:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "prisma:seed": "node --env-file-if-exists=../../.env node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:transfer": "pnpm prisma:generate:source && node --env-file-if-exists=../../.env node_modules/tsx/dist/cli.mjs prisma/transfer-cockroach-to-postgres.ts",
    "db:validate-transfer": "pnpm prisma:generate:source && node --env-file-if-exists=../../.env node_modules/tsx/dist/cli.mjs prisma/validate-postgres-transfer.ts",
    "db:transfer:typecheck": "pnpm prisma:generate:source && tsc -p tsconfig.transfer.json",
    "db:smoke": "node --env-file-if-exists=../../.env node_modules/tsx/dist/cli.mjs prisma/postgres-smoke.ts",
    "db:reconcile-hosted-customers": "node --env-file-if-exists=../../.env node_modules/tsx/dist/cli.mjs prisma/reconcile-hosted-customers.ts",
    "campaigns:backfill-assets": "node --env-file-if-exists=../../.env node_modules/tsx/dist/cli.mjs prisma/backfill-homepage-campaign-assets.ts",
    "db:reconcile-recharges": "node --env-file-if-exists=../../.env node_modules/tsx/dist/cli.mjs prisma/reconcile-recharge-customers.ts"
  },
  "dependencies": {
    "@clerk/backend": "^2.14.0",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.15.0",
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/client-sesv2": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@visa-compass/shared": "workspace:*",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "pdfkit": "^0.19.1",
    "pino": "^9.9.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.4",
    "svix": "^1.73.0",
    "tesseract.js": "^6.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
