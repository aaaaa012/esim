# Runtime
# NODE_ENV is intentionally left unset here. The Next.js portals need to drive
# build-time NODE_ENV themselves (production during `next build`); setting a
# literal `development` value here leaks into `next build` and breaks
# prerendering of the default /404 and /500 error pages. API/worker start
# commands must set NODE_ENV explicitly; deployed services use production.
PORT=4000
API_PUBLIC_URL=http://localhost:4000
CUSTOMER_WEB_URL=http://localhost:3000
OPS_WEB_URL=http://localhost:3001

# Sensitive-data protection (generate unique values; never reuse these examples)
APP_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
PII_HASH_KEY=replace-with-a-long-random-key

# PostgreSQL / Prisma. Keep application data in the private visa_compass schema.
DATABASE_URL=postgresql://user:password@localhost:5432/postgres?schema=visa_compass&sslmode=disable
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/postgres?schema=visa_compass&sslmode=disable
# Used only during the one-time CockroachDB-to-PostgreSQL transfer.
SOURCE_DATABASE_URL=
PERSISTENCE_MODE=prisma

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
# Verified-by-value Super Admin bootstrap token. In production this is MANDATORY
# (bootstrap fails closed without it). POST /auth/bootstrap only promotes the
# account whose email matches BOOTSTRAP_SUPER_ADMIN_EMAIL when this exact token
# is submitted (constant-time compare), is rate-limited, and refuses to run once
# any active Super Admin exists. Generate with: openssl rand -hex 32
BOOTSTRAP_SUPER_ADMIN_TOKEN=
# Staff accounts can only be created at this email domain (approval-gated, no public staff signup).
STAFF_EMAIL_DOMAIN=visacompassnepal.com

# BullMQ Redis TCP/TLS connection (leave blank for queue simulation)
REDIS_URL=
QUEUE_CONCURRENCY=3
# How often background usage reconciliation polls active subscriptions (minutes).
RECONCILIATION_INTERVAL_MINUTES=15
# How often recent pending payments are re-checked with the payment provider
# (seconds). Backstop for browser payment verification; confirms Completed
# lookups and leaves Pending ones alone. On Render this only fires while the
# instance is awake.
PAYMENT_RECONCILE_INTERVAL_SECONDS=45
PAYMENT_VERIFY_ATTEMPTS=3
INVENTORY_PROVIDER_FRESHNESS_HOURS=24
INVENTORY_RESERVATION_STALE_HOURS=2
REFUND_ATTENTION_HOURS=24

# Observability
# Emit each request log line as a JSON object instead of human-readable text.
LOG_FORMAT=plain
# Recipient for operational alert emails (PROVISIONING_FAILED, etc.). Leave
# blank to disable email alerts (failures are still logged and counted in /metrics).
OPS_ALERT_EMAIL=
ADMIN_ALERT_EMAIL=
# The /metrics endpoint is public (no PII) and served in Prometheus text format.

# Login-free ("guest") checkout: HMAC secret used to sign order-bound access tokens.
# Must be unique per environment and never shared with clients.
GUEST_ORDER_SECRET=replace-with-a-long-random-guest-token-secret

# API hardening
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=60
# Max size of accepted JSON/urlencoded request bodies (guards against oversized
# CSV/Excel imports and other memory-exhaustion attacks).
BODY_LIMIT=5mb
# Express `trust proxy` value. Leave blank when clients connect directly. When
# the API sits behind a reverse proxy / load balancer set this to the number of
# trusted proxy hops (e.g. 1) or a comma-separated address list. Never trust
# forwarded IP headers from arbitrary clients.
TRUST_PROXY=
# Expose Swagger API docs (off by default; enable explicitly).
SWAGGER_ENABLED=false

# Payments (Khalti is the sole payment gateway)
PAYMENT_MODE=simulator
PAYMENT_SIMULATOR_SECRET=local-development-only-change-me
# HMAC secret used to verify payment webhook callbacks (X-Visa-Signature). In
# production this is MANDATORY; outside production it falls back to
# PAYMENT_SIMULATOR_SECRET so local flows stay easy to exercise.
PAYMENT_WEBHOOK_SECRET=
# Khalti ePayment e.g. https://dev.khalti.com/api/v2 (sandbox) or https://khalti.com/api/v2 (production)
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# live_secret_key from test-admin.khalti.com (sandbox) or admin.khalti.com (production)
KHALTI_SECRET_KEY=
# Khalti request timeout in ms (default 15000)
KHALTI_REQUEST_TIMEOUT_MS=15000

# Fonepay Checkout Intent / Dynamic QR. Keep disabled until Fonepay has
# registered the public key that matches FONEPAY_PRIVATE_KEY_BASE64.
FONEPAY_ENABLED=false
FONEPAY_BASE_URL=
FONEPAY_USERNAME=
FONEPAY_PASSWORD=
FONEPAY_TERMINAL_ID=
FONEPAY_PRIVATE_KEY_BASE64=

# Connectivity (Transatel is the production provider)
# Transatel: base URL is the API root (e.g. https://api.transatel.com); domain-specific
# base URLs are derived automatically (ocs/subscriptions, ocs/catalog, ocs/inventory,
# sim-management/sims, webhooks, authentication).
TRANSATEL_BASE_URL=
TRANSATEL_CLIENT_ID=
TRANSATEL_CLIENT_SECRET=
TRANSATEL_MVNO_REF=
TRANSATEL_COS=
# OCS order payment provider (credit | customer | none). Leave empty to omit payment.
TRANSATEL_PAYMENT_PROVIDER=none
# Subscriber identifier used in bind.msisdn when placing OCS orders (default: iccid).
TRANSATEL_SUBSCRIBER_IDENTIFIER=iccid
# Catalog sync pricing: subscription fee currency from the catalog (EUR) converted to NPR.
TRANSATEL_FX_TO_NPR=170
# Sync the Transatel catalog into the plans database on application startup.
TRANSATEL_CATALOG_SYNC_ON_STARTUP=false
# Outbound webhook registration (optional). When set, the provider registers/updates a
# Transatel webhook targeting your public API. Secret signs requests via X-TSL-Signature-256.
TRANSATEL_WEBHOOK_TARGET_URL=
TRANSATEL_WEBHOOK_CONTACT_EMAIL=
TRANSATEL_WEBHOOK_SECRET=
TRANSATEL_WEBHOOK_EVENTS=OCS/PRODUCT/PRELOADED,OCS/PRODUCT/ACTIVATED,OCS/PRODUCT/CANCELED,OCS/PRODUCT/EXPIRED,OCS/PRODUCT/TERMINATED,CONNECTIVITY-MANAGEMENT/SUBSCRIBER/SUSPENDED,CONNECTIVITY-MANAGEMENT/SUBSCRIBER/TERMINATED
# Outbound API request timeout in milliseconds.
TRANSATEL_REQUEST_TIMEOUT_MS=15000
TRANSATEL_CIRCUIT_FAILURE_THRESHOLD=5
TRANSATEL_CIRCUIT_RESET_MS=30000
TRANSATEL_INVENTORY_RECONCILE_HOURS=24
TRANSATEL_INVENTORY_RECONCILE_BATCH_SIZE=25
TRANSATEL_RECONCILIATION_CONCURRENCY=1

# Private document and marketing media storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_MARKETING_ASSET_BUCKET=
# Absolute public API media route, e.g. https://api.example.com/api/v1/public/marketing-assets
PUBLIC_ASSET_BASE_URL=
# Optional for local S3-compatible development only.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Passport OCR verification (Tesseract.js)
# By default the "eng" traineddata (~15 MB) is fetched from jsDelivr at first
# use and cached. In production, pre-download it and point TESSERACT_LANG_PATH
# at the folder so the API can read OCR without network access at runtime.
# TESSERACT_LANG=eng
# TESSERACT_LANG_PATH=/var/tessdata
# TESSERACT_CACHE_PATH=/var/tessdata/cache

# Notifications
NOTIFICATION_MODE=simulator
EMAIL_PROVIDER=ses
AWS_SES_REGION=ap-south-1
AWS_SES_CONFIGURATION_SET=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Visa Compass
EMAIL_REPLY_TO=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Both Next.js portals use this public API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Must match PUBLIC_ASSET_BASE_URL when remote campaign uploads are enabled.
NEXT_PUBLIC_ASSET_BASE_URL=

# JSON array of partner id + SHA-256 API-key hash; never store plaintext keys
PARTNER_API_KEYS_JSON=[]
# Maximum number of fresh, provider-safe profiles that may replace an eSIM
# definitively rejected before Transatel accepts any subscription.
MAX_PROVISIONING_PROFILE_SWAPS=2
# OCR technical-outage recovery: keep checkout pending briefly, then require
# manual review if the dedicated OCR worker has not recovered.
OCR_FAILURE_GRACE_SECONDS=30
OCR_TECHNICAL_RETRY_SECONDS=10
OCR_RECOVERY_SWEEP_SECONDS=5
