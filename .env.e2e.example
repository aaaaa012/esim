# Browser automation. Copy to an ignored local environment source or configure
# these values as CI secrets. Never commit real credentials.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Optional staging URLs. When E2E_CUSTOMER_BASE_URL is set, Playwright does not
# start local Next.js servers.
E2E_CUSTOMER_BASE_URL=
E2E_OPS_BASE_URL=

# Dedicated disposable users for authenticated browser projects.
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_OPS_EMAIL=
E2E_OPS_PASSWORD=
E2E_SUPER_ADMIN_EMAIL=
E2E_SUPER_ADMIN_PASSWORD=
